{
  "name": "dsh-trip-log",
  "version": "0.1.0",
  "type": "module",
  "description": "行程记录：把一趟趟出门摊成时间线、词云和相册橱窗。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Ricardozhuyuyu/dsh-trip-log.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "trip",
    "timeline",
    "travel"
  ]
}
